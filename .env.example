# ==========================================
# CẤU HÌNH HỆ THỐNG - SECONDHAND MARKETPLACE
# ==========================================

# Cấu hình ứng dụng
APP_NAME="Secondhand Marketplace"
APP_ENV=local
APP_DEBUG=true
# Nếu chạy trên XAMPP/Laragon, chỉnh lại APP_URL cho đúng thư mục dự án
# Ví dụ: http://localhost/market/public hoặc http://market.test
APP_URL=http://localhost/market/public

# Cấu hình kết nối MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secondhand_marketplace
DB_USER=root
DB_PASS=

# Cấu hình Upload
UPLOAD_MAX_FILESIZE=5242880 # 5MB tính theo bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

